/* Global styles, in PostCSS syntax. Tailwind supplies almost everything; see
   tailwind.config.cjs for the theme. An unadopted palette and type scale that
   used to sit commented out below now live in plans/colours-and-type.md. */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  /* The theme is the .dark class on <html> (set in app.html, toggled by the
     nav), not the OS preference. Without this the UA picks its own scheme from
     the OS, so on a dark-preferring machine the default text colour stayed
     white while Tailwind painted the light background underneath it. */
  :root {
    color-scheme: light;
  }
  :root.dark {
    color-scheme: dark;
  }

  /* The site leans on motion — the mark bounces and spins on hover, the title
     cross-fades over a second, project cards lift and their screenshots scale.
     For anyone who has asked their system for less of that, hold still. */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}
